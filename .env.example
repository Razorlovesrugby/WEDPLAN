# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL and the publishable (anon) key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Used exclusively by src/lib/supabase/admin.ts for the public RSVP path,
# which must write rows for an unauthenticated visitor holding a token.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# The site's own origin. Used to build RSVP links and QR codes, and as the
# magic-link redirect target.
#
# A bare hostname is accepted — "wedplan.vercel.app" becomes
# "https://wedplan.vercel.app", and localhost gets http:// — so pasting a
# domain straight out of the Vercel dashboard works. Trailing slashes are
# stripped.
#
# On Vercel, if this is unset the project's production domain is used, then the
# deployment URL. Set it explicitly once there is a custom domain: that is the
# only source that knows about it, and these URLs go out in email and onto
# printed QR codes.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pepper mixed into the invitation token hash. Generate once, never rotate
# without re-issuing every invitation:  openssl rand -hex 32
#
# NOTE this peppers THREE things now, not one: invitation links, moodboard
# share links (/m/...), and the Chrome clipper's tokens. Rotating it
# invalidates all three at once. It was always break-glass; it is now slightly
# more glass.
INVITE_TOKEN_PEPPER=

# ---------------------------------------------------------------------------
# Email (V1: outbound only, no inbox — see docs/wedding-platform-spec.md)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Wedding <rsvp@example.com>"
EMAIL_REPLY_TO=

# Shared secret for /api/cron/* routes. Vercel Cron sends this as a bearer
# token; any request without it is rejected.  openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# Moodboards (docs/specs/09-moodboards.md)
# ---------------------------------------------------------------------------
# Images live in a PRIVATE Supabase Storage bucket called "moodboards". There
# is no environment variable for it — but it does not exist until somebody
# runs, once per environment:
#
#   node scripts/ensure-bucket.mjs
#
# Without it, uploads fail with "Storage isn't reachable".

# ---------------------------------------------------------------------------
# Pinterest (docs/specs/09.1-pinterest-import-and-clipper.md)
# ---------------------------------------------------------------------------
# Both optional. Unset, /settings shows "not configured" and everything else
# in the app works normally — the Chrome clipper does not need these at all.
#
# Register an app at Pinterest's developer portal. Its redirect URI is this
# site's /api/pinterest/callback and generally has to be HTTPS, so a plain
# http://localhost:3000 callback is usually rejected: run the connect flow
# against the deployed URL, or a tunnel.
#
# A new app normally starts on a trial access tier limited to its owner's own
# account, which is exactly what this feature wants. Scopes requested are
# read-only: boards:read, boards:read_secret, pins:read, pins:read_secret.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
